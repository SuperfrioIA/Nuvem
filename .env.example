# Postgres
POSTGRES_PASSWORD=troque_essa_senha

# Admin
ADMIN_PASSWORD=troque_essa_senha_tambem
SECRET_KEY=gere_uma_string_aleatoria_longa_aqui

# Onde os xlsx do upload manual ficam retidos (pasta na VM, fora do container).
# Plugavel: migra pra SharePoint (Graph API) quando o Entra ID for liberado.
UPLOADS_HOST_PATH=./data/uploads

# Limite de tamanho de upload em MB (opcional; default 50 — o maior arquivo
# real da POC, o fato de volumetria, tem ~30 MB)
#UPLOAD_MAX_MB=50

# Microsoft Graph — leitura do SharePoint DataHub (conector sharepoint_excel).
# App `nuvem-ia` no Entra ID, permissao Sites.Selected + concessao `read` no site.
# SOMENTE LEITURA: o papel `read` faz o Graph recusar qualquer escrita.
# O CLIENT_SECRET e o valor da coluna "Value" do Azure (nao o "Secret ID", que e um
# GUID) e expira em 12 meses. Ver docs/FONTES_DATAHUB.md.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_PATH=superfrioarmazens.sharepoint.com:/sites/DataHub
GRAPH_PASTA=00.Dados/00.Bronze/00.Dados_Sistemicos

# Anthropic Claude — chat do Laboratorio de Insights (Bloco E / V1.5).
# Leitura preguicosa: sem a chave, o app sobe normal e so falha quando o chat
# for de fato usado. IA_MODELO/IA_EFFORT tem default, trocaveis sem redeploy.
ANTHROPIC_API_KEY=
#IA_MODELO=claude-sonnet-5
#IA_EFFORT=medium

# DW Oracle -- volumetria de catering (V3.5). SOMENTE LEITURA: o carregador so
# emite SELECT, e ha guarda estatica e de runtime na suite.
# Usuario de servico `INTEGRACAO_DADOS_CATERING`, senha OPEN e sem expiracao
# (verificado em 25/ago/2026). O VALOR da senha nunca entra em arquivo
# versionado, log, teste ou documento -- ele vive so no .env desta maquina e no
# .env da VM.
DW_USER=
DW_SENHA=
# Host, porta e servico tem padrao no codigo (catering/carga/fonte_oracle.py) e
# so precisam estar aqui para trocar de ambiente. Oracle 12.2.0.1.0, modo thin.
#DW_HOST=oracleprd-aws.superfrio.com.br
#DW_PORTA=1521
#DW_BANCO=pdwgener
# O nome dos objetos vive em configuracao (A-7 do V3_PLANO): hoje e a _V01, e a
# FATO_VOLUMETRIA do mesmo schema ja esta em _V04 -- versao subir e o
# comportamento normal daquele time. Trocar aqui nao exige commit.
#DW_TABELA_REC=DM_VOLUMETRIA.FATO_VOL_REC_CAT_V01
#DW_TABELA_EXP=DM_VOLUMETRIA.FATO_VOL_EXP_CAT_V01
# Primeiro ano que a carga le, por nk_calendario (a data do movimento). Decisao
# da Maria em 25/ago/2026: a V3 le de 2026 para frente -- o DW reconstruiu as
# tabelas com historico desde 2023, e 2023-2025 nao serve a tela de hoje. Fica
# em configuracao porque comparar 2025 com 2026 e caso de uso previsto: baixar
# para 2025 carrega o passado, sem commit. Subir de novo NAO apaga o que ja
# entrou -- a carga so insere e atualiza.
#DW_ANO_MINIMO=2026
