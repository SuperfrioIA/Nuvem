# Postgres
POSTGRES_PASSWORD=troque_essa_senha

# Admin
ADMIN_PASSWORD=troque_essa_senha_tambem
SECRET_KEY=gere_uma_string_aleatoria_longa_aqui

# Onde os xlsx do upload manual ficam retidos (pasta na VM, fora do container).
# Plugavel: migra pra SharePoint (Graph API) quando o Entra ID for liberado.
UPLOADS_HOST_PATH=./data/uploads

# Limite de tamanho de upload em MB (opcional; default 50 — o maior arquivo
# real da POC, o fato de volumetria, tem ~30 MB)
#UPLOAD_MAX_MB=50

# Microsoft Graph — leitura do SharePoint DataHub (conector sharepoint_excel).
# App `nuvem-ia` no Entra ID, permissao Sites.Selected + concessao `read` no site.
# SOMENTE LEITURA: o papel `read` faz o Graph recusar qualquer escrita.
# O CLIENT_SECRET e o valor da coluna "Value" do Azure (nao o "Secret ID", que e um
# GUID) e expira em 12 meses. Ver docs/FONTES_DATAHUB.md.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SITE_PATH=superfrioarmazens.sharepoint.com:/sites/DataHub
GRAPH_PASTA=00.Dados/00.Bronze/00.Dados_Sistemicos

# Anthropic Claude — chat do Laboratorio de Insights (Bloco E / V1.5).
# Leitura preguicosa: sem a chave, o app sobe normal e so falha quando o chat
# for de fato usado. IA_MODELO/IA_EFFORT tem default, trocaveis sem redeploy.
ANTHROPIC_API_KEY=
#IA_MODELO=claude-sonnet-5
#IA_EFFORT=medium

# App da V3 -- volumetria de catering (V3.4 em diante).
# CAT_SECRET_KEY e OBRIGATORIA e e PROPRIA da V3: nao e a SECRET_KEY da V2. Sem
# ela o app sobe e o /health responde 200, mas login e sessao estouram -- falha
# que parece "app no ar" para quem so olha o healthcheck. Gerar uma por
# ambiente, longa e aleatoria; nunca reaproveitar entre local e VM.
CAT_SECRET_KEY=
# Cookie sem `secure` porque nao ha HTTPS na porta 8003 -- fraqueza declarada no
# V3.4, e vale tambem na VM. Ligar so quando houver TLS na frente, senao o
# navegador para de mandar o cookie e ninguem consegue entrar.
#CAT_COOKIE_SECURE=0
# CAT_ADMIN_LOGIN/CAT_ADMIN_SENHA criam o PRIMEIRO admin, e so quando
# cat_usuarios esta vazia. Ficam FORA daqui de proposito: o caminho preferido e
# o CLI (`python -m catering.seguranca criar`), que pede a senha por getpass e
# nao a deixa em arquivo nem no historico do shell.

# DW Oracle -- volumetria de catering (V3.5). SOMENTE LEITURA: o carregador so
# emite SELECT, e ha guarda estatica e de runtime na suite.
# Usuario de servico `INTEGRACAO_DADOS_CATERING`, senha OPEN e sem expiracao
# (verificado em 25/ago/2026). O VALOR da senha nunca entra em arquivo
# versionado, log, teste ou documento -- ele vive so no .env desta maquina e no
# .env da VM.
DW_USER=
DW_SENHA=
# Host, porta e servico tem padrao no codigo (catering/carga/fonte_oracle.py) e
# so precisam estar aqui para trocar de ambiente. Oracle 12.2.0.1.0, modo thin.
#DW_HOST=oracleprd-aws.superfrio.com.br
#DW_PORTA=1521
#DW_BANCO=pdwgener
# O nome dos objetos vive em configuracao (A-7 do V3_PLANO): hoje e a _V01, e a
# FATO_VOLUMETRIA do mesmo schema ja esta em _V04 -- versao subir e o
# comportamento normal daquele time. Trocar aqui nao exige commit.
#DW_TABELA_REC=DM_VOLUMETRIA.FATO_VOL_REC_CAT_V01
#DW_TABELA_EXP=DM_VOLUMETRIA.FATO_VOL_EXP_CAT_V01
# Primeiro ano que a CARGA le, por nk_calendario (a data do movimento). O padrao
# e 2023 = o historico inteiro que o DW publica (V3.8, 27/ago/2026). Em 25/ago o
# padrao era 2026, e mudou quando o V3.7 fez a tela abrir em janeiro do ano
# corrente: guardar historico e escolher onde comecar a olhar sao decisoes
# separadas (esta e a da carga; a da tela e CAT_ABERTURA_DE).
#
# A variavel agora serve para ESTREITAR: local, DW_ANO_MINIMO=2026 carrega so o
# ano corrente e sobe rapido. Em PRODUCAO ela fica em 2023 -- o piso esta no
# WHERE de toda rodada, entao subi-lo faria as atualizacoes que o DW fizer em
# linha de 2023-2025 pararem de chegar, e a copia do historico congelaria
# divergindo da fonte em silencio.
#
# Subir o piso NAO apaga o que ja entrou -- a carga so insere e atualiza.
#DW_ANO_MINIMO=2023
# Fuso em que data e hora APARECEM na tela -- o rodape "De quando e o dado" e a
# coluna "quando" da auditoria. O dado sempre foi gravado em UTC (timestamptz),
# que e o certo; o que faltava era converter na exibicao. Sem isto, uma carga das
# 09h45 aparecia como 12h45 (medido em 26/ago/2026). Fuso desconhecido falha
# nomeando esta variavel, em vez de o Postgres estourar no meio de uma consulta
# de tela. Nao confundir com o fuso do crontab, que e UTC de proposito (DEPLOY.md).
#CAT_FUSO_EXIBICAO=America/Sao_Paulo
# Primeiro dia do recorte com que a TELA ABRE -- nao confundir com DW_ANO_MINIMO,
# que e o piso da CARGA. A carga guarda o historico; a tela escolhe onde comecar
# a olhar, e quem quiser o passado filtra para tras.
#
# Dois valores validos:
#   ano-corrente   1o de janeiro do ano de hoje (o padrao, pedido pela Maria em
#                  26/ago/2026: "janeiro do ano corrente ate o mes atual")
#   AAAA-MM-DD     data fixa, para pinar. Em 01/jan/2027 o rolante abre com uma
#                  coluna so -- se isso incomodar, `CAT_ABERTURA_DE=2026-01-01`
#                  resolve sem commit.
# O `ate` e sempre HOJE, lido do Postgres no fuso acima (o container roda em UTC,
# e as 21h de Brasilia ja sao o dia seguinte la).
#CAT_ABERTURA_DE=ano-corrente
